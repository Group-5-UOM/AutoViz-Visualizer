# Database — Neon (managed Postgres) or a local Postgres.
#
# System Postgres (e.g. pgAdmin on port 5432):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/autoviz
#
# Docker Compose DB (host port 5434):
#   docker compose -f backend/docker-compose.yml up -d db
#   DATABASE_URL=postgresql://autoviz:autoviz@localhost:5434/autoviz
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoviz

# JWT secret (reserved for future token signing; current auth uses opaque tokens).
SECRET_KEY=autoviz-dev-secret-key-change-in-production

# API gateway
AUTOVIZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
AUTOVIZ_UPLOAD_TTL_HOURS=24

# Durable agent threads: set to "postgres" to persist LangGraph conversation
# state across restarts (uses DATABASE_URL). Default is in-memory.
AUTOVIZ_AGENT_CHECKPOINTER=

# Planner LLM (only needed for the /agent routes)
GOOGLE_API_KEY=
