# Database — Neon (managed Postgres) or a local Postgres.
#
# System Postgres (e.g. pgAdmin on port 5432):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/autoviz
#
# Docker Compose DB (host port 5434):
#   docker compose -f backend/docker-compose.yml up -d db
#   DATABASE_URL=postgresql://autoviz:autoviz@localhost:5434/autoviz
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoviz

# JWT secret (reserved for future token signing; current auth uses opaque tokens).
SECRET_KEY=autoviz-dev-secret-key-change-in-production

# API gateway
AUTOVIZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Resident DataFrame budget (bytes) before the registry evicts least-recently-used
# datasets. Evicted frames reload from their stored Parquet blob on next use, so
# this trades memory for an occasional reload — it never loses data. Default 512 MiB.
AUTOVIZ_REGISTRY_MEMORY_BYTES=536870912

# Durable agent threads: set to "postgres" to persist LangGraph conversation
# state across restarts (uses DATABASE_URL). Default is in-memory.
AUTOVIZ_AGENT_CHECKPOINTER=

# Planner LLM (only needed for the /agent routes).
# Pick one provider:
#   OpenAI:  set OPENAI_API_KEY + AUTOVIZ_PLANNER_MODEL=openai:gpt-4o-mini
#   Google:  set GOOGLE_API_KEY  (default model is google_genai:gemini-3.5-flash)
OPENAI_API_KEY=
AUTOVIZ_PLANNER_MODEL=openai:gpt-4o-mini
GOOGLE_API_KEY=

# OAuth login (Google / GitHub authorization-code)
#
# LOCAL testing (defaults):
AUTOVIZ_FRONTEND_URL=http://localhost:5173
AUTOVIZ_API_PUBLIC_URL=http://127.0.0.1:8000
#
# HOSTED (example — set these on the server instead of hardcoding in code):
# AUTOVIZ_FRONTEND_URL=https://autoviz.duckdns.org
# AUTOVIZ_API_PUBLIC_URL=https://autoviz.duckdns.org
#
# Optional explicit redirect overrides (normally leave blank):
# GITHUB_OAUTH_REDIRECT_URI=https://autoviz.duckdns.org/auth/oauth/github/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://autoviz.duckdns.org/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REDIRECT_URI=

